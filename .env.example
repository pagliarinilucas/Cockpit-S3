# ─── Cockpit S3 — production env (copy to .env or set these in Dokploy) ───

# Auth (CRITICAL). Must be 32+ chars. Generate: openssl rand -hex 32
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_TTL=900            # access token lifetime (s) — 15 min
REFRESH_TOKEN_TTL=2592000       # refresh token lifetime (s) — 30 days
COOKIE_SECURE=true              # keep true behind HTTPS

# Initial admin — created only on first boot (when no users exist).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=                 # leave blank to get a random one printed in the logs

# Host port to publish (plain docker compose). Dokploy uses your domain instead.
PORT=3000

# Garage/S3 connections are added from the UI (Conexões) and stored in the DB —
# no S3_* needed here. (If you ever want to seed the first one, you can still pass
# S3_ENDPOINT / S3_REGION / S3_ACCESS_KEY / S3_SECRET_KEY / BUCKETS.)
