# ---- server ----
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:4200

# ---- auth (CRITICAL) ----
# 32+ chars. Generate: openssl rand -hex 32
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_TTL=900           # access token lifetime (s) — 15 min
REFRESH_TOKEN_TTL=2592000      # refresh token lifetime (s) — 30 days
COOKIE_SECURE=false            # set true in production (HTTPS)
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_MS=300000

# ---- initial admin (created on first boot if no users exist) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=                # if blank, a random one is generated and printed

# ---- storage / Garage S3 ----
DB_PATH=./data/cockpit.sqlite
# S3_* are OPTIONAL: an admin can configure Garage from the UI (Configurações),
# which is saved in the DB and takes precedence. These only seed the first boot.
S3_ENDPOINT=
S3_REGION=garage
S3_ACCESS_KEY=
S3_SECRET_KEY=
BUCKETS=                       # csv of bucket names to manage; blank = ListBuckets
