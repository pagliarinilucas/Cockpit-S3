{
  "name": "cockpit-s3-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "seed": "bun src/scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "bun --bun drizzle-kit generate",
    "db:migrate": "bun --bun drizzle-kit migrate",
    "db:studio": "bun --bun drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.717.0",
    "@aws-sdk/s3-request-presigner": "^3.717.0",
    "@elysiajs/cors": "^1.2.0",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.2.10",
    "jose": "^5.9.6",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.35.1"
  },
  "devDependencies": {
    "bun-types": "^1.1.42",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.6.3"
  }
}
